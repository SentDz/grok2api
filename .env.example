# External Statsig signer and watcher. Copy to .env and fill these four values.
STATSIG_LLM_BASE=https://your-llm-provider.example/v1
STATSIG_LLM_API_KEY=
STATSIG_LLM_MODEL=grok-4.6
STATSIG_GROK_SSO=

# HTML checks every 60 seconds; browser verification every 30 checks.
STATSIG_WATCH_INTERVAL=60
STATSIG_DEEP_EVERY=30
STATSIG_REPAIR_RETRY_SECONDS=300
STATSIG_AGENT_MAX_TURNS=200

# Optional browser proxy. Leave empty for a direct connection.
STATSIG_PROXY_SERVER=
STATSIG_PROXY_USERNAME=
STATSIG_PROXY_PASSWORD=
